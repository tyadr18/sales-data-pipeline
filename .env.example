# このファイルを .env にコピーして値を設定してください（.env は Git 管理外です）
#   cp .env.example .env

# 入力CSVのパス
SALES_INPUT_PATH=data/sample_sales.csv

# レポートの出力先ディレクトリ（日付ごとのサブフォルダが作られます）
SALES_OUTPUT_DIR=reports

# 商品ランキングに載せる件数
SALES_TOP_N=5

# 金額の末尾に付ける単位
SALES_CURRENCY_LABEL=円

# Slack Incoming Webhook の URL（秘密情報。実際の値はコミットしないこと）
# このツールは通知文を作るだけで送信はしません。設定の有無だけを表示します。
SLACK_WEBHOOK_URL=

# 通知先チャンネル（任意。ペイロードに含めたい場合のみ）
SLACK_CHANNEL=#sales-report
